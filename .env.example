# Multi-Key Pool for NewsAPI.org (Round-Robin Rotation & Quota Failover)
# 4 API Keys are configured here as requested by your class instructor.
# If a key reaches its 100 requests/day limit, the system automatically fails over to the next key!
NEWS_API_KEY_1=your_first_newsapi_key_here
NEWS_API_KEY_2=your_second_newsapi_key_here
NEWS_API_KEY_3=your_third_newsapi_key_here
NEWS_API_KEY_4=your_fourth_newsapi_key_here

PORT=5000
FLASK_ENV=development
